{
  "name": "@embetty/monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "bun run --filter \"*\" build",
    "test": "bun run --filter \"*\" test",
    "prepare": "git config core.hooksPath .githooks",
    "bump": "changeset version && bun install",
    "release": "bun run build && bun scripts/publish.ts"
  },
  "dependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.8",
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@embetty/tsconfig": "workspace:^",
    "@types/bun": "^1.4.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.19.2"
  },
  "workspaces": [
    "libs/*",
    "tools/*",
    "embetty",
    "embetty-server"
  ],
  "overrides": {
    "typescript": "5.5.3"
  }
}
