{
  "name": "@embetty/server",
  "version": "3.2.12",
  "main": "dist/index.js",
  "author": "Philipp Busse <pmb@heise.de>",
  "license": "MIT",
  "bin": {
    "embetty": "bin/embetty",
    "embetty-start": "bin/embetty-start"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "bun --watch src/server.ts",
    "test": "bun test ./src",
    "build": "rm -rf dist && bun build src/server.ts src/index.ts --outdir dist --target node --format cjs --packages external --sourcemap=linked --dts",
    "start:docker": "docker run --env URL_BASE=http://localhost:8080 --env EMBETTY_CACHE= -p8080:8080 --rm --env-file .env heiseonline/embetty-server"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@embetty/tsconfig": "workspace:*",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.9"
  },
  "dependencies": {
    "@embetty/base": "workspace:*",
    "@embetty/component": "workspace:*",
    "debug": "^4.4.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1"
  }
}
