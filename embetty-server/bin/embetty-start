#!/usr/bin/env node

const { parseArgs } = require('node:util')

const USAGE = `Usage: embetty start [options]

Options:
  -p, --port <port>    The HTTP port you want to start embetty on. Default: 3000
  -v, --verbose        output verbose messages on internal operations
  -d, --debug          output debug messages
  -c, --cache <cache>  Connection string of a cache adapter. Default: "lru://"
  -h, --help           display help`

const { values } = parseArgs({
  options: {
    port: { type: 'string', short: 'p' },
    verbose: { type: 'boolean', short: 'v' },
    debug: { type: 'boolean', short: 'd' },
    cache: { type: 'string', short: 'c' },
    help: { type: 'boolean', short: 'h' },
  },
})

if (values.help) {
  console.log(USAGE)
  process.exit(0)
}

process.env.NODE_ENV = 'production'

if (values.cache) process.env.EMBETTY_CACHE = values.cache
if (values.debug) process.env.DEBUG = '*'
if (values.port) process.env.PORT = values.port
if (values.verbose) process.env.DEBUG = 'embetty*'

require('../dist/server')
