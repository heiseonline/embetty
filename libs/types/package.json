{
  "name": "@embetty/types",
  "version": "2.1.3",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@embetty/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target node --format cjs --packages external --define process.env.NODE_ENV=process.env.NODE_ENV --sourcemap=linked --dts"
  },
  "devDependencies": {
    "@embetty/tsconfig": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
