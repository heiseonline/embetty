{
  "name": "@embetty/base",
  "version": "2.1.3",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@embetty/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target node --format cjs --packages external --sourcemap=linked --dts",
    "test": "bun test ./src",
    "test:node": "node --test node-test/guarded-fetch.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@embetty/types": "workspace:^",
    "cheerio": "1.0.0-rc.12",
    "debug": "^4.3.7",
    "ioredis": "^5.4.1",
    "ipaddr.js": "^2.2.0",
    "lru-cache": "^9.1.2"
  },
  "devDependencies": {
    "@embetty/tsconfig": "workspace:*",
    "@types/debug": "^4.1.12"
  }
}
