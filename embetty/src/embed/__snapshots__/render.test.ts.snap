exports[`rendering renders a tweet with hashtags, media and a link 1`] = `"<header><img src="/tweet/1/profile-image"><span><strong>sfi</strong><a href="https://twitter.com/SiLVAFiSH" target="_blank" rel="noopener">@SiLVAFiSH</a></span></header><article><p><a href="https://twitter.com/hashtag/TGIF!">#TGIF!</a> Möget ihr ein besseres <a href="https://twitter.com/hashtag/Wochenende">#Wochenende</a> haben als diese <a href="https://twitter.com/hashtag/Katzen,">#Katzen,</a> die <a href="https://twitter.com/hashtag/Wochenenddienst">#Wochenenddienst</a> im <a href="https://twitter.com/hashtag/Callcenter">#Callcenter</a> haben. https://t.co/sjf82H3rCj</p><section class="media-hint"><a href="https://twitter.com/SiLVAFiSH/status/1" target="_blank" rel="noopener"> Weitere Inhalte des Posts auf x.com </a></section><a href="https://x.com/SiLVAFiSH/status/934029337019416579/photo/1" target="_blank" rel="noopener" id="links"><img src="/tweet/1/link-image"><section id="link-body"><h3>sfi (@SiLVAFiSH) on X</h3><p>#TGIF! Möget ihr ein besseres #Wochenende haben als diese #Katzen, die #Wochenenddienst im #Callcenter haben.</p><span>x.com</span></section></a><a href="https://twitter.com/SiLVAFiSH/status/1" target="_blank" rel="noopener" id="created-at" class="tweet__link"><time datetime="2017-11-24T12:02:02.000Z">10.3.2013, 15:07:53</time> via X (Twitter) <svg id="xcorp-icon" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 22.1 20" preserveAspectRatio="xMinYMin" style="height: 12px"><path id="path2" d="M17.4,0h3.4l-7.4,8.5L22.1,20h-6.8L10,13l-6.1,7H0.4l7.9-9.1L0,0h7l4.8,6.4L17.4,0z M16.2,18h1.9L6,1.9H4 L16.2,18z"></path></svg></a><a href="https://www.heise.de/embetty?wt_mc=link.embetty.poweredby" target="_blank" rel="noopener" id="powered-by" title="embetty - displaying remote content without compromising your privacy."> powered by <!--?xml version="1.0" encoding="UTF-8" standalone="no"?--><svg width="100%" height="100%" viewBox="0 0 76 146" v